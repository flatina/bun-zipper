{
  "name": "@flatina/bun-zipper",
  "version": "0.3.0",
  "description": "ZIP container reader/writer for Bun. No bundled compression algorithm — deflate is the runtime's.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "zip",
    "unzip",
    "bun",
    "archive",
    "zip64",
    "deflate",
    "compression"
  ],
  "homepage": "https://github.com/flatina/bun-zipper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flatina/bun-zipper.git"
  },
  "bugs": {
    "url": "https://github.com/flatina/bun-zipper/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.6"
  },
  "scripts": {
    "test": "bun test",
    "test:large": "BUN_ZIPPER_LARGE=1 bun test test/large.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "latest",
    "fflate": "^0.8.3",
    "typescript": "^5"
  }
}
